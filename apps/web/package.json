{
  "name": "@geo-companion/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
