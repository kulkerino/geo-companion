{
  "components": {
    "schemas": {
      "Attribution": {
        "additionalProperties": false,
        "description": "Rights and provenance required for every published educational claim or asset.",
        "properties": {
          "accessed_on": {
            "format": "date",
            "title": "Accessed On",
            "type": "string"
          },
          "attribution_text": {
            "minLength": 1,
            "title": "Attribution Text",
            "type": "string"
          },
          "creator": {
            "minLength": 1,
            "title": "Creator",
            "type": "string"
          },
          "geographic_scope": {
            "minLength": 1,
            "title": "Geographic Scope",
            "type": "string"
          },
          "license_name": {
            "minLength": 1,
            "title": "License Name",
            "type": "string"
          },
          "license_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "License Url",
            "type": "string"
          },
          "reviewed_on": {
            "format": "date",
            "title": "Reviewed On",
            "type": "string"
          },
          "rights_status": {
            "$ref": "#/components/schemas/RightsStatus"
          },
          "source_title": {
            "minLength": 1,
            "title": "Source Title",
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "source_title",
          "source_url",
          "creator",
          "license_name",
          "license_url",
          "attribution_text",
          "accessed_on",
          "reviewed_on",
          "geographic_scope",
          "rights_status"
        ],
        "title": "Attribution",
        "type": "object"
      },
      "Citation": {
        "additionalProperties": false,
        "description": "A citation is an attribution attached to a claim.",
        "properties": {
          "accessed_on": {
            "format": "date",
            "title": "Accessed On",
            "type": "string"
          },
          "attribution_text": {
            "minLength": 1,
            "title": "Attribution Text",
            "type": "string"
          },
          "creator": {
            "minLength": 1,
            "title": "Creator",
            "type": "string"
          },
          "geographic_scope": {
            "minLength": 1,
            "title": "Geographic Scope",
            "type": "string"
          },
          "license_name": {
            "minLength": 1,
            "title": "License Name",
            "type": "string"
          },
          "license_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "License Url",
            "type": "string"
          },
          "reviewed_on": {
            "format": "date",
            "title": "Reviewed On",
            "type": "string"
          },
          "rights_status": {
            "$ref": "#/components/schemas/RightsStatus"
          },
          "source_title": {
            "minLength": 1,
            "title": "Source Title",
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "source_title",
          "source_url",
          "creator",
          "license_name",
          "license_url",
          "attribution_text",
          "accessed_on",
          "reviewed_on",
          "geographic_scope",
          "rights_status"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Coordinate": {
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Coordinate",
        "type": "object"
      },
      "Feedback": {
        "additionalProperties": false,
        "properties": {
          "attempt_id": {
            "minLength": 1,
            "title": "Attempt Id",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "rating": {
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating",
            "type": "integer"
          },
          "reported_issue": {
            "default": false,
            "title": "Reported Issue",
            "type": "boolean"
          },
          "round_id": {
            "minLength": 1,
            "title": "Round Id",
            "type": "string"
          }
        },
        "required": [
          "attempt_id",
          "round_id",
          "rating"
        ],
        "title": "Feedback",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LessonPublic": {
        "additionalProperties": false,
        "description": "A lesson projection that cannot leak the deterministic answer key.",
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "diagram_asset_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diagram Asset Id"
          },
          "lesson_id": {
            "title": "Lesson Id",
            "type": "string"
          },
          "quiz_items": {
            "items": {
              "$ref": "#/components/schemas/QuizItemPublic"
            },
            "title": "Quiz Items",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "lesson_id",
          "title",
          "body",
          "citations",
          "quiz_items"
        ],
        "title": "LessonPublic",
        "type": "object"
      },
      "LessonSummary": {
        "additionalProperties": false,
        "properties": {
          "lesson_id": {
            "title": "Lesson Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "lesson_id",
          "title"
        ],
        "title": "LessonSummary",
        "type": "object"
      },
      "LessonsResponse": {
        "additionalProperties": false,
        "properties": {
          "lessons": {
            "items": {
              "$ref": "#/components/schemas/LessonSummary"
            },
            "title": "Lessons",
            "type": "array"
          }
        },
        "required": [
          "lessons"
        ],
        "title": "LessonsResponse",
        "type": "object"
      },
      "PackSummary": {
        "additionalProperties": false,
        "properties": {
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "pack_id": {
            "title": "Pack Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "pack_id",
          "version",
          "content_hash"
        ],
        "title": "PackSummary",
        "type": "object"
      },
      "PacksResponse": {
        "additionalProperties": false,
        "properties": {
          "packs": {
            "items": {
              "$ref": "#/components/schemas/PackSummary"
            },
            "title": "Packs",
            "type": "array"
          }
        },
        "required": [
          "packs"
        ],
        "title": "PacksResponse",
        "type": "object"
      },
      "PracticeAnswerResult": {
        "additionalProperties": false,
        "description": "Post-submission reveal with deterministic scoring and a local attempt identity.",
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/SourceTruthAnswer"
          },
          "attempt_id": {
            "title": "Attempt Id",
            "type": "string"
          },
          "is_correct": {
            "title": "Is Correct",
            "type": "boolean"
          },
          "round_id": {
            "title": "Round Id",
            "type": "string"
          },
          "study_progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StudyProgress"
              },
              {
                "type": "null"
              }
            ]
          },
          "submission": {
            "$ref": "#/components/schemas/PracticeAnswerSubmission"
          }
        },
        "required": [
          "round_id",
          "answer",
          "attempt_id",
          "is_correct",
          "submission"
        ],
        "title": "PracticeAnswerResult",
        "type": "object"
      },
      "PracticeAnswerSubmission": {
        "additionalProperties": false,
        "properties": {
          "coordinate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinate"
              },
              {
                "type": "null"
              }
            ]
          },
          "country_code": {
            "anyOf": [
              {
                "maxLength": 2,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country Code"
          },
          "region_code": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region Code"
          },
          "skipped": {
            "default": false,
            "title": "Skipped",
            "type": "boolean"
          },
          "uncertain": {
            "default": false,
            "title": "Uncertain",
            "type": "boolean"
          }
        },
        "title": "PracticeAnswerSubmission",
        "type": "object"
      },
      "PracticeClue": {
        "additionalProperties": false,
        "description": "An optional authored clue, distinct from the hidden answer.",
        "properties": {
          "clue": {
            "title": "Clue",
            "type": "string"
          },
          "round_id": {
            "title": "Round Id",
            "type": "string"
          }
        },
        "required": [
          "round_id",
          "clue"
        ],
        "title": "PracticeClue",
        "type": "object"
      },
      "PracticeRoundPublic": {
        "additionalProperties": false,
        "description": "Pre-submission contract deliberately omitting both answer and coordinates.",
        "properties": {
          "asset_attribution": {
            "$ref": "#/components/schemas/Attribution"
          },
          "asset_id": {
            "title": "Asset Id",
            "type": "string"
          },
          "round_id": {
            "title": "Round Id",
            "type": "string"
          }
        },
        "required": [
          "round_id",
          "asset_id",
          "asset_attribution"
        ],
        "title": "PracticeRoundPublic",
        "type": "object"
      },
      "QuizAnswerResult": {
        "additionalProperties": false,
        "properties": {
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "is_correct": {
            "title": "Is Correct",
            "type": "boolean"
          },
          "lesson_id": {
            "title": "Lesson Id",
            "type": "string"
          },
          "quiz_id": {
            "title": "Quiz Id",
            "type": "string"
          },
          "selected_choice": {
            "title": "Selected Choice",
            "type": "string"
          }
        },
        "required": [
          "lesson_id",
          "quiz_id",
          "selected_choice",
          "is_correct",
          "explanation",
          "citations"
        ],
        "title": "QuizAnswerResult",
        "type": "object"
      },
      "QuizAnswerSubmission": {
        "additionalProperties": false,
        "properties": {
          "selected_choice": {
            "minLength": 1,
            "title": "Selected Choice",
            "type": "string"
          }
        },
        "required": [
          "selected_choice"
        ],
        "title": "QuizAnswerSubmission",
        "type": "object"
      },
      "QuizItemPublic": {
        "additionalProperties": false,
        "description": "Quiz prompt shown before the learner commits an answer.",
        "properties": {
          "choices": {
            "items": {
              "type": "string"
            },
            "title": "Choices",
            "type": "array"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "quiz_id": {
            "title": "Quiz Id",
            "type": "string"
          }
        },
        "required": [
          "quiz_id",
          "prompt",
          "choices"
        ],
        "title": "QuizItemPublic",
        "type": "object"
      },
      "RightsStatus": {
        "enum": [
          "cleared",
          "reference-only",
          "quarantined"
        ],
        "title": "RightsStatus",
        "type": "string"
      },
      "SourceTruthAnswer": {
        "additionalProperties": false,
        "description": "Pack-authored ground truth; never derived from learner or model activity.",
        "properties": {
          "answer_origin": {
            "enum": [
              "source_truth",
              "authored"
            ],
            "title": "Answer Origin",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "minItems": 1,
            "title": "Citations",
            "type": "array"
          },
          "coordinate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinate"
              },
              {
                "type": "null"
              }
            ]
          },
          "country_code": {
            "maxLength": 2,
            "minLength": 2,
            "title": "Country Code",
            "type": "string"
          },
          "explanation": {
            "minLength": 1,
            "title": "Explanation",
            "type": "string"
          }
        },
        "required": [
          "country_code",
          "explanation",
          "citations",
          "answer_origin"
        ],
        "title": "SourceTruthAnswer",
        "type": "object"
      },
      "StudyGrade": {
        "additionalProperties": false,
        "properties": {
          "lesson_id": {
            "minLength": 1,
            "title": "Lesson Id",
            "type": "string"
          },
          "quality": {
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Quality",
            "type": "integer"
          },
          "reviewed_at": {
            "format": "date-time",
            "title": "Reviewed At",
            "type": "string"
          }
        },
        "required": [
          "lesson_id",
          "quality",
          "reviewed_at"
        ],
        "title": "StudyGrade",
        "type": "object"
      },
      "StudyProgress": {
        "additionalProperties": false,
        "properties": {
          "ease_factor": {
            "minimum": 1.3,
            "title": "Ease Factor",
            "type": "number"
          },
          "interval_days": {
            "minimum": 0.0,
            "title": "Interval Days",
            "type": "integer"
          },
          "last_reviewed_on": {
            "format": "date",
            "title": "Last Reviewed On",
            "type": "string"
          },
          "lesson_id": {
            "minLength": 1,
            "title": "Lesson Id",
            "type": "string"
          },
          "repetitions": {
            "minimum": 0.0,
            "title": "Repetitions",
            "type": "integer"
          }
        },
        "required": [
          "lesson_id",
          "repetitions",
          "interval_days",
          "ease_factor"
        ],
        "title": "StudyProgress",
        "type": "object"
      },
      "StudyReview": {
        "additionalProperties": false,
        "description": "The next local review; an empty queue is an expected clean-start state.",
        "properties": {
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StudyProgress"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "StudyReview",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Geo Companion API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/feedback": {
      "post": {
        "description": "Persist local feedback; reports remain separate from verified source truth.",
        "operationId": "submit_feedback_api_v1_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Feedback"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Feedback"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Report that the local API process is accepting requests.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/lessons": {
      "get": {
        "description": "List the three original, cleared starter lessons.",
        "operationId": "list_lessons_api_v1_lessons_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Lessons"
      }
    },
    "/api/v1/lessons/{lesson_id}": {
      "get": {
        "description": "Return a safe lesson projection; its quiz key is not serialised.",
        "operationId": "get_lesson_api_v1_lessons__lesson_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "lesson_id",
            "required": true,
            "schema": {
              "title": "Lesson Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonPublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Lesson"
      }
    },
    "/api/v1/lessons/{lesson_id}/quizzes/{quiz_id}/answers": {
      "post": {
        "description": "Check one deterministic quiz answer and release its cited explanation.",
        "operationId": "submit_quiz_answer_api_v1_lessons__lesson_id__quizzes__quiz_id__answers_post",
        "parameters": [
          {
            "in": "path",
            "name": "lesson_id",
            "required": true,
            "schema": {
              "title": "Lesson Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "quiz_id",
            "required": true,
            "schema": {
              "title": "Quiz Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuizAnswerSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuizAnswerResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Quiz Answer"
      }
    },
    "/api/v1/packs": {
      "get": {
        "description": "Expose the immutable bundled starter pack without a lifecycle/install flow.",
        "operationId": "list_packs_api_v1_packs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PacksResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Packs"
      }
    },
    "/api/v1/practice/rounds/next": {
      "get": {
        "description": "Serve an original diagram only; answers never leave this route before submission.",
        "operationId": "next_practice_round_api_v1_practice_rounds_next_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PracticeRoundPublic"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Next Practice Round"
      }
    },
    "/api/v1/practice/rounds/{round_id}/answers": {
      "post": {
        "description": "Persist the pseudonymous attempt, then reveal independently sourced truth.",
        "operationId": "submit_practice_answer_api_v1_practice_rounds__round_id__answers_post",
        "parameters": [
          {
            "in": "path",
            "name": "round_id",
            "required": true,
            "schema": {
              "title": "Round Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PracticeAnswerSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PracticeAnswerResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Practice Answer"
