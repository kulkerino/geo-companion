{
  "components": {
    "schemas": {
      "Attribution": {
        "additionalProperties": false,
        "description": "Rights and provenance required for every published educational claim or asset.",
        "properties": {
          "accessed_on": {
            "format": "date",
            "title": "Accessed On",
            "type": "string"
          },
          "attribution_text": {
            "minLength": 1,
            "title": "Attribution Text",
            "type": "string"
          },
          "creator": {
            "minLength": 1,
            "title": "Creator",
            "type": "string"
          },
          "geographic_scope": {
            "minLength": 1,
            "title": "Geographic Scope",
            "type": "string"
          },
          "license_name": {
            "minLength": 1,
            "title": "License Name",
            "type": "string"
          },
          "license_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "License Url",
            "type": "string"
          },
          "reviewed_on": {
            "format": "date",
            "title": "Reviewed On",
            "type": "string"
          },
          "rights_status": {
            "$ref": "#/components/schemas/RightsStatus"
          },
          "source_title": {
            "minLength": 1,
            "title": "Source Title",
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "source_title",
          "source_url",
          "creator",
          "license_name",
          "license_url",
          "attribution_text",
          "accessed_on",
          "reviewed_on",
          "geographic_scope",
          "rights_status"
        ],
        "title": "Attribution",
        "type": "object"
      },
      "Citation": {
        "additionalProperties": false,
        "description": "A citation is an attribution attached to a claim.",
        "properties": {
          "accessed_on": {
            "format": "date",
            "title": "Accessed On",
            "type": "string"
          },
          "attribution_text": {
            "minLength": 1,
            "title": "Attribution Text",
            "type": "string"
          },
          "creator": {
            "minLength": 1,
            "title": "Creator",
            "type": "string"
          },
          "geographic_scope": {
            "minLength": 1,
            "title": "Geographic Scope",
            "type": "string"
          },
          "license_name": {
            "minLength": 1,
            "title": "License Name",
            "type": "string"
          },
          "license_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "License Url",
            "type": "string"
          },
          "reviewed_on": {
            "format": "date",
            "title": "Reviewed On",
            "type": "string"
          },
          "rights_status": {
            "$ref": "#/components/schemas/RightsStatus"
          },
          "source_title": {
            "minLength": 1,
            "title": "Source Title",
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "source_title",
          "source_url",
          "creator",
          "license_name",
          "license_url",
          "attribution_text",
          "accessed_on",
          "reviewed_on",
          "geographic_scope",
          "rights_status"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Coordinate": {
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Coordinate",
        "type": "object"
      },
      "Feedback": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "rating": {
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating",
            "type": "integer"
          },
          "reported_issue": {
            "default": false,
            "title": "Reported Issue",
            "type": "boolean"
          },
          "round_id": {
            "minLength": 1,
            "title": "Round Id",
            "type": "string"
          }
        },
        "required": [
          "round_id",
          "rating"
        ],
        "title": "Feedback",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Lesson": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "minItems": 1,
            "title": "Citations",
            "type": "array"
          },
          "lesson_id": {
            "minLength": 1,
            "title": "Lesson Id",
            "type": "string"
          },
          "quiz_items": {
            "items": {
              "$ref": "#/components/schemas/QuizItem"
            },
            "title": "Quiz Items",
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "lesson_id",
          "title",
          "body",
          "citations",
          "quiz_items"
        ],
        "title": "Lesson",
        "type": "object"
      },
      "LessonSummary": {
        "additionalProperties": false,
        "properties": {
          "lesson_id": {
            "title": "Lesson Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "lesson_id",
          "title"
        ],
        "title": "LessonSummary",
        "type": "object"
      },
      "LessonsResponse": {
        "additionalProperties": false,
        "properties": {
          "lessons": {
            "items": {
              "$ref": "#/components/schemas/LessonSummary"
            },
            "title": "Lessons",
            "type": "array"
          }
        },
        "required": [
          "lessons"
        ],
        "title": "LessonsResponse",
        "type": "object"
      },
      "PackSummary": {
        "additionalProperties": false,
        "properties": {
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "pack_id": {
            "title": "Pack Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "pack_id",
          "version",
          "content_hash"
        ],
        "title": "PackSummary",
        "type": "object"
      },
      "PacksResponse": {
        "additionalProperties": false,
        "properties": {
          "packs": {
            "items": {
              "$ref": "#/components/schemas/PackSummary"
            },
            "title": "Packs",
            "type": "array"
          }
        },
        "required": [
          "packs"
        ],
        "title": "PacksResponse",
        "type": "object"
      },
      "PracticeAnswerSubmission": {
        "additionalProperties": false,
        "properties": {
          "coordinate": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinate"
              },
              {
                "type": "null"
              }
            ]
          },
          "country_code": {
            "anyOf": [
              {
                "maxLength": 2,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country Code"
          },
          "region_code": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region Code"
          },
          "skipped": {
            "default": false,
            "title": "Skipped",
            "type": "boolean"
          },
          "uncertain": {
            "default": false,
            "title": "Uncertain",
            "type": "boolean"
          }
        },
        "title": "PracticeAnswerSubmission",
        "type": "object"
      },
      "PracticeReveal": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/SourceTruthAnswer"
          },
          "round_id": {
            "title": "Round Id",
            "type": "string"
          }
        },
        "required": [
          "round_id",
          "answer"
        ],
        "title": "PracticeReveal",
        "type": "object"
      },
      "PracticeRoundPublic": {
        "additionalProperties": false,
        "description": "Pre-submission contract deliberately omitting both answer and coordinates.",
        "properties": {
          "asset_attribution": {
            "$ref": "#/components/schemas/Attribution"
          },
          "asset_id": {
            "title": "Asset Id",
            "type": "string"
          },
          "round_id": {
            "title": "Round Id",
            "type": "string"
          }
        },
        "required": [
          "round_id",
          "asset_id",
          "asset_attribution"
        ],
        "title": "PracticeRoundPublic",
        "type": "object"
      },
      "QuizItem": {
        "additionalProperties": false,
        "properties": {
          "choices": {
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "title": "Choices",
            "type": "array"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "minItems": 1,
            "title": "Citations",
            "type": "array"
          },
          "correct_choice": {
            "minLength": 1,
            "title": "Correct Choice",
            "type": "string"
          },
          "explanation": {
            "minLength": 1,
            "title": "Explanation",
            "type": "string"
          },
          "prompt": {
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "quiz_id": {
            "minLength": 1,
            "title": "Quiz Id",
            "type": "string"
          }
        },
        "required": [
          "quiz_id",
          "prompt",
          "choices",
          "correct_choice",
          "explanation",
          "citations"
        ],
        "title": "QuizItem",
        "type": "object"
      },
      "RightsStatus": {
        "enum": [
          "cleared",
          "reference-only",
          "quarantined"
        ],
        "title": "RightsStatus",
        "type": "string"
      },
      "SourceTruthAnswer": {
        "additionalProperties": false,
        "description": "Pack-authored ground truth; never derived from learner or model activity.",
        "properties": {
          "answer_origin": {
            "enum": [
              "source_truth",
              "authored"
            ],
            "title": "Answer Origin",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "minItems": 1,
            "title": "Citations",
            "type": "array"
          },
          "coordinate": {
            "$ref": "#/components/schemas/Coordinate"
          },
          "country_code": {
            "maxLength": 2,
            "minLength": 2,
            "title": "Country Code",
            "type": "string"
          },
          "explanation": {
            "minLength": 1,
            "title": "Explanation",
            "type": "string"
          }
        },
        "required": [
          "country_code",
          "coordinate",
          "explanation",
          "citations",
          "answer_origin"
        ],
        "title": "SourceTruthAnswer",
        "type": "object"
      },
      "StudyGrade": {
        "additionalProperties": false,
        "properties": {
          "lesson_id": {
            "minLength": 1,
            "title": "Lesson Id",
            "type": "string"
          },
          "quality": {
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Quality",
            "type": "integer"
          },
          "reviewed_at": {
            "format": "date-time",
            "title": "Reviewed At",
            "type": "string"
          }
        },
        "required": [
          "lesson_id",
          "quality",
          "reviewed_at"
        ],
        "title": "StudyGrade",
        "type": "object"
      },
      "StudyProgress": {
        "additionalProperties": false,
        "properties": {
          "ease_factor": {
            "minimum": 1.3,
            "title": "Ease Factor",
            "type": "number"
          },
          "interval_days": {
            "minimum": 0.0,
            "title": "Interval Days",
            "type": "integer"
          },
          "last_reviewed_on": {
            "format": "date",
            "title": "Last Reviewed On",
            "type": "string"
          },
          "lesson_id": {
            "minLength": 1,
            "title": "Lesson Id",
            "type": "string"
          },
          "repetitions": {
            "minimum": 0.0,
            "title": "Repetitions",
            "type": "integer"
          }
        },
        "required": [
          "lesson_id",
          "repetitions",
          "interval_days",
          "ease_factor"
        ],
        "title": "StudyProgress",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Geo Companion API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/feedback": {
      "post": {
        "description": "Reject feedback until Task 3 adds local persistence rather than discarding it.",
        "operationId": "submit_feedback_api_v1_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Feedback"
              }
            }
          },
          "required": true
        },
        "responses": {
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Submit Feedback"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Report that the local API process is accepting requests.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/lessons": {
      "get": {
        "description": "List lessons from active cleared packs; empty is safe before activation exists.",
        "operationId": "list_lessons_api_v1_lessons_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Lessons"
      }
    },
    "/api/v1/lessons/{lesson_id}": {
      "get": {
        "description": "Reserve the lesson detail contract without exposing unpublished content.",
        "operationId": "get_lesson_api_v1_lessons__lesson_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "lesson_id",
            "required": true,
            "schema": {
              "title": "Lesson Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lesson"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Lesson"
      }
    },
    "/api/v1/packs": {
      "get": {
        "description": "List active packs; Task 4 will populate this from atomically activated storage.",
        "operationId": "list_packs_api_v1_packs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PacksResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Packs"
      }
    },
    "/api/v1/practice/rounds/next": {
      "get": {
        "description": "A pre-submit round would omit its answer; no activated round exists yet.",
        "operationId": "next_practice_round_api_v1_practice_rounds_next_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PracticeRoundPublic"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Next Practice Round"
      }
    },
    "/api/v1/practice/rounds/{round_id}/answers": {
      "post": {
        "description": "Reserve post-submit reveal; Task 3 will grade and reveal verified source truth.",
        "operationId": "submit_practice_answer_api_v1_practice_rounds__round_id__answers_post",
        "parameters": [
          {
            "in": "path",
            "name": "round_id",
            "required": true,
            "schema": {
              "title": "Round Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PracticeAnswerSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PracticeReveal"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Practice Answer"
      }
    },
    "/api/v1/study/grades": {
      "post": {
        "description": "Reserve the SM-2 grade command without calculating a schedule in Task 2.",
        "operationId": "record_study_grade_api_v1_study_grades_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudyGrade"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudyProgress"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Record Study Grade"
      }
    },
    "/api/v1/study/progress/{lesson_id}": {
      "get": {
        "description": "Expose a stable not-found contract before the learner scheduler is implemented.",
        "operationId": "get_study_progress_api_v1_study_progress__lesson_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "lesson_id",
            "required": true,
            "schema": {
              "title": "Lesson Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudyProgress"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Study Progress"
      }
    }
  }
}
